{
  "settings": {
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "tr_lowercase": {
          "type": "lowercase",
          "language": "turkish"
        }
      },
      "analyzer": {
        "tr_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [ "apostrophe", "tr_lowercase", "asciifolding" ]
        }
      },
      "normalizer": {
        "tr_keyword": {
          "type": "custom",
          "filter": [ "tr_lowercase", "asciifolding" ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "trackingNo": { "type": "keyword" },
      "senderName": {
        "type": "text",
        "analyzer": "tr_text",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "receiverCity": {
        "type": "keyword",
        "normalizer": "tr_keyword",
        "fields": { "raw": { "type": "keyword" } }
      },
      "originBranchId": { "type": "integer" },
      "status": { "type": "byte" },
      "weightKg": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "createdAt": { "type": "date" },
      "deliveredAt": { "type": "date" }
    }
  }
}